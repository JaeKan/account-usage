+def _fetch_anthropic_plan(headers: dict) -> Optional[str]:
+    """Plan label from the OAuth profile endpoint (fail-open enrichment).
+
+    The usage endpoint carries no plan field; ``/api/oauth/profile`` does:
+    personal ``has_claude_max/pro`` flags, or the organization
+    ``organization_type`` + ``seat_tier`` for Team/Enterprise seats.
+    Email/org names are deliberately excluded — plan tier only.
+    """
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            response = client.get("https://api.anthropic.com/api/oauth/profile", headers=headers)
+            response.raise_for_status()
+        payload = response.json() or {}
+    except Exception:
+        return None
+    account = payload.get("account") or {}
+    if account.get("has_claude_max"):
+        return "Max"
+    if account.get("has_claude_pro"):
+        return "Pro"
+    org = payload.get("organization") or {}
+    org_type = str(org.get("organization_type") or "")
+    seat = str(org.get("seat_tier") or "")
+    if "team" in org_type:
+        return f"Team {_title_case_slug(seat.replace('team_', ''))}" if seat else "Team"
+    if "enterprise" in org_type:
+        return "Enterprise"
+    return None
+
