+class CodexQuotaCooldown(RuntimeError):
+    """All pool credentials are rate/billing-limited; carries recovery ETA."""
+
+    def __init__(self, wait_seconds: int):
+        self.wait_seconds = wait_seconds
+        super().__init__(f"cooling down, retry in {wait_seconds}s")
