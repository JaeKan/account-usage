+# account-usage plugin RPC (source of truth: desktop-plugins/account-usage/backend/hermes-customs.patch — do not hand-edit).
+@method("account.usage")
+def _(rid, params: dict) -> dict:
+    """Per-provider account/rate-limit snapshot for the desktop statusbar chips.
+
+    Thin RPC wrapper over ``agent.account_usage.fetch_account_usage`` — the
+    same fetch the ``/usage`` slash command uses (gateway/slash_commands.py).
+    Each provider fetch is a blocking HTTP round-trip; kept off the main
+    thread via _LONG_HANDLERS (see server.py, same posture as session.usage).
+    Fail-open per provider: one provider's failure never blanks the others.
+    """
+    from concurrent.futures import ThreadPoolExecutor
+
+    from agent.account_usage import fetch_account_usage
+
+    providers = ("openai-codex", "anthropic", "openrouter", "cursor", "antigravity")
+    requested = (params or {}).get("provider")
+    if requested is not None and requested not in providers:
+        return _err(rid, -32602, "Unsupported account usage provider")
+    targets = (requested,) if requested is not None else providers
+
+    def _fetch_card(provider: str) -> dict:
+        try:
+            snapshot = fetch_account_usage(provider)
+        except Exception as exc:
+            # Transient (timeout, 5xx, DNS) vs. no-credential are different
+            # facts — collapsing both into "not connected" hid every real
+            # network blip as a false "log back in" signal.
+            return {"provider": provider, "available": False, "windows": [], "unavailable_reason": f"temporarily unavailable: {exc}"}
+        if snapshot is None:
+            return {"provider": provider, "available": False, "windows": [], "unavailable_reason": "not connected"}
+        return {
+            "provider": provider,
+            "available": snapshot.available,
+            "plan": snapshot.plan,
+            "unavailable_reason": snapshot.unavailable_reason,
+            "windows": [
+                {
+                    "label": w.label,
+                    "used_percent": w.used_percent,
+                    "reset_at": w.reset_at.isoformat() if w.reset_at else None,
+                    "detail": w.detail,
+                    "amount_usd": w.amount_usd,
+                }
+                for w in snapshot.windows
+            ],
+        }
+
+    # Five independent HTTP round-trips serialized one-by-one used to cost
+    # ~1s each; a thread per provider turns that into the slowest single call.
+    with ThreadPoolExecutor(max_workers=len(targets)) as pool:
+        cards = list(pool.map(_fetch_card, targets))
+    return _ok(rid, {"cards": cards})
+
+
